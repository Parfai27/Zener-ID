ENVIRONMENT=development
ENABLE_DOCS=true
# Local Postgres. Create the role and database as the README describes,
# then put the password you chose here.
DATABASE_URL=postgresql+psycopg://kyc:CHANGE_ME@localhost:5432/kyc
REDIS_URL=redis://localhost:6379/0

# Evidence (document photos, the portrait, the liveness clip) is kept in Google
# Drive, reached with a Google Cloud service account key.
# From the key's JSON, two fields:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private key, with its newlines written as \n, quoted:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Or, if you would rather mount the whole key file, its contents instead:
GOOGLE_SERVICE_ACCOUNT_JSON=

# The folder evidence goes in, on a Shared Drive the service account is a member
# of, its id out of the URL:
# https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=
# The platform's own folder inside it, made on first use:
GOOGLE_DRIVE_ROOT_FOLDER=KYC Verifications

# Where evidence goes while none of the above is set: a folder on this machine.
# That is how tests and a developer's laptop run.
EVIDENCE_DIR=var/evidence

# Separate AML service (Yente); use its private DNS/address, not container localhost.
YENTE_BASE_URL=http://localhost:8080
YENTE_API_TOKEN=
YENTE_SCREENING_DATASET=sanctions
YENTE_POSSIBLE_THRESHOLD=0.7
YENTE_STRONG_THRESHOLD=0.9

# Outgoing email (password resets) over SMTP, through SendGrid.
# SMTP_USER is literally "apikey"; SMTP_PASSWORD is a SendGrid API key with
# Mail Send permission (Settings > API Keys). EMAIL_FROM must be a verified
# sender (Settings > Sender Authentication). Set EMAIL_ENABLED=true once these
# are filled in, then restart. In development, false shows the reset link on
# the sign-in page instead.
DASHBOARD_URL=http://localhost:5173
# Verification links open the frontend applicant flow at <VERIFY_BASE_URL>/verify/<token>.
VERIFY_BASE_URL=http://localhost:5173
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=Zener ID <no-reply@your-domain.com>
